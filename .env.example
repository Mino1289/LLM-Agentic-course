LLM_PROVIDER=openai    # openai, github_models, azure_openai, nvidia_nim, or gemini

# OpenAI setup
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

# GitHub Models setup
GITHUB_MODELS_API_KEY=
# IDs sans préfixe openai/ (endpoint models.inference.ai.azure.com)
GITHUB_CHAT_MODEL=gpt-4.1-mini
GITHUB_EMBEDDING_MODEL=text-embedding-3-small
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com

# NVIDIA NIM setup (cloud: https://integrate.api.nvidia.com/v1)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_CHAT_MODEL=google/diffusiongemma-26b-a4b-it
NVIDIA_NIM_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Gemini chat (embeddings use EMBEDDING_PROVIDER, default openai)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
EMBEDDING_PROVIDER=openai    # openai, github_models, azure_openai, or nvidia_nim

# Azure OpenAI setup (chat + embeddings, indépendant du chat provider)
# Utiliser EMBEDDING_PROVIDER=azure_openai pour les embeddings seulement
# ou LLM_PROVIDER=azure_openai pour le chat aussi
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://mon-ressource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# LangSmith observability
# REGION=eu si compte sur https://eu.smith.langchain.com (sinon us)
LANGSMITH_TRACING=true
LANGSMITH_REGION=eu
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finance-rag-langgraph
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_PROJECT=finance-rag-langgraph

# SEC crawler identity (required by SEC policy)
SEC_USER_AGENT=MyFinanceRAG your-email@example.com

# Earnings call transcripts (optionnel ; activé via --earnings ou BOOTSTRAP_EARNINGS=true)
# Clé Alpha Vantage gratuite (endpoint EARNINGS_CALL_TRANSCRIPT). Sans clé,
# l'étape earnings est ignorée. Free tier : 25 req/jour, 5/min -> sur le free
# tier, mets EARNINGS_INTER_CALL_SLEEP=15 et restreins --min-year/--max-year.
ALPHAVANTAGE_API_KEY=
EARNINGS_INTER_CALL_SLEEP=0.25

# Bootstrap behavior
SKIP_DOWNLOAD_IF_EXISTS=false
SKIP_PREPROCESS_IF_EXISTS=false
BOOTSTRAP_MIN_YEAR=2024
BOOTSTRAP_MAX_YEAR=2026
BOOTSTRAP_SECTIONS=1a,7
BOOTSTRAP_EXCLUDE_8K=false
BOOTSTRAP_EARNINGS=false

# Runtime tuning
EMBEDDING_DAILY_USED=0
EMBEDDING_DAILY_LIMIT=0
EMBEDDING_RPM=120
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
MEMORY_WINDOW_SIZE=6
SUMMARIZE_EVERY_N_TURNS=6
MAX_CONTEXT_CHUNKS=8
MAX_CONTEXT_TOKENS=3500
QUERY_DECOMPOSE_COUNT=4
MAX_TOOL_ITERATIONS=6
PRICE_TOOL_ENABLED=true
PRICE_MAX_DAYS=180
PRICE_MAX_POINTS=40
PRICE_MAX_TICKERS=3
PRICE_DEFAULT_DAYS=90
PRICE_MAX_ATTEMPTS=2

# CORS (origines autorisées pour le frontend Next.js ; ports custom ex. 3030)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Alpaca Paper Trading (see rag/alpaca_tools.py)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# DEV ONLY — contourne l'approbation humaine avant un ordre (garde-fou désactivé).
# Laisser vide en démo/production.
ALLOW_TRADE_WITHOUT_APPROVAL=
# Si "true", un FAIL Compliance répété est forcé en OVERRULED (puis approbation humaine).
# Désactivé par défaut : un refus Compliance bloque l'ordre.
COMPLIANCE_ALLOW_OVERRULE=
